# Host web publik, tanpa skema. Konfigurasi HTTPS di reverse proxy.
DOMAIN=drive.example.com
NODE_ENV=production
PORT=5080
# Nama host yang digunakan perangkat untuk SMB, tanpa port.
SMB_HOST=drive.example.com
# Isi alamat IP antarmuka server yang menerima koneksi dari domain.
SMB_BIND_ADDRESS=127.0.0.1
POSTGRES_USER=drivemesh
POSTGRES_PASSWORD=
POSTGRES_DB=drivemesh
DATABASE_URL=postgresql://drivemesh:CHANGE_ME@localhost:5434/drivemesh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Rahasia acak unik minimal 32 karakter. Simpan sebagai rahasia dan jangan ubah sembarangan.
MASTER_KEY=
