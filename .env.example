# ==========================================
# DRIVEMESH ENVIRONMENT CONFIGURATION
# ==========================================

# Domain & Protocols
DOMAIN=drivemesh.farhan-dev.my.id
NODE_ENV=production
PORT=5080

# PostgreSQL Configuration
POSTGRES_USER=drivemesh
POSTGRES_PASSWORD=drivemesh_secure_pass
POSTGRES_DB=drivemesh
DATABASE_URL=postgresql://drivemesh:drivemesh_secure_pass@localhost:5434/drivemesh

# Google Cloud OAuth2 Credentials
# Dapatkan dari Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://drivemesh.farhan-dev.my.id/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-Byte Master Vault Encryption Key (AES-256-GCM)
MASTER_KEY=drivemesh-enterprise-vault-secure-master-key-32b!
