{
  "name": "drivemesh",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Google Drive gateway for SMB clients",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=@drivemesh/server run dev",
    "dev:client": "npm --workspace=@drivemesh/client run dev",
    "build:server": "npm --workspace=@drivemesh/server run build",
    "build:client": "npm --workspace=@drivemesh/client run build",
    "build": "npm --workspace=@drivemesh/shared run build && npm --workspace=@drivemesh/server run build && npm --workspace=@drivemesh/client run build",
    "start:server": "npm --workspace=@drivemesh/server run start",
    "start:client": "npm --workspace=@drivemesh/client run start"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farhan0431/drivemesh.git"
  }
}
